# Пример файла конфигурации для бота управления Minecraft сервером
# Скопируйте этот файл в .env и заполните своими данными

# Токен вашего бота от @BotFather
TELEGRAM_API_BOT=your_bot_token_here

# Список ID разрешенных пользователей через запятую (без пробелов)
# Чтобы узнать свой ID, напишите боту @userinfobot
TELEGRAM_ALLOWED_USERS=12345678,87654321
