[Container]
Image=docker.io/library/python:3.11-slim
ContainerName=bot-minecraft
Environment=PYTHONUNBUFFERED=1
Exec=sh -c "pip install --no-cache-dir -r /home/podman-svc/pod/bot-minecraft/bot/requirements.txt && export PYTHONPATH=/home/podman-svc/pod/bot-minecraft && python /home/podman-svc/pod/bot-minecraft/bot/main.py"

# 1. Access to Minecraft data for world management
Volume=/mnt/library/containers/minecraft/data:/mnt/library/containers/minecraft/data:Z

# 2. Access to bot files
Volume=/home/podman-svc/pod/bot-minecraft:/home/podman-svc/pod/bot-minecraft:Z

Network=services-net.network
